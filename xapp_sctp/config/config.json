{
  "xapp_name": "testar-e2sim-xapp",
  "version": "1.0.0",
  "containers": [
    {
      "name": "testar-e2sim-xapp",
      "image": {
        "registry": "",
        "name": "testar-e2sim-xapp",
        "tag": "latest"
      }
    }
  ],
  "livenessProbe": {
    "httpGet": {
      "path": "/ric/v1/health/alive",
      "port": 8080
    },
    "initialDelaySeconds": 5,
    "periodSeconds": 15
  },
  "readinessProbe": {
    "httpGet": {
      "path": "/ric/v1/health/ready",
      "port": 8080
    },
    "initialDelaySeconds": 5,
    "periodSeconds": 15
  },
  "messaging": {
    "ports": [
      {
        "name": "http",
        "container": "testar-e2sim-xapp",
        "port": 8080,
        "description": "http service"
      },
      {
        "name": "rmr-data",
        "container": "testar-e2sim-xapp",
        "port": 4560,
        "rxMessages": ["RIC_SUB_RESP", "RIC_INDICATION", "RIC_SUB_FAILURE"],
        "txMessages": ["RIC_SUB_REQ", "RIC_SUB_DEL_REQ"],
        "description": "rmr data port"
      },
      {
        "name": "rmr-route",
        "container": "testar-e2sim-xapp",
        "port": 4561,
        "description": "rmr route port"
      }
    ]
  },
  "rmr": {
    "protPort": "tcp:4560",
    "maxSize": 2074,
    "numWorkers": 1,
    "rxMessages": ["RIC_SUB_RESP", "RIC_INDICATION", "RIC_SUB_FAILURE"],
    "txMessages": ["RIC_SUB_REQ", "RIC_SUB_DEL_REQ"]
  }
}
